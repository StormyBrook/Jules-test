{
    "version": 2,
    "builds": [
        {
            "src": "src/web_main.py",
            "use": "@vercel/python",
            "config": {
                "maxLambdaSize": "15mb",
                "runtime": "python3.9"
            }
        }
    ],
    "routes": [
        {
            "src": "/static/(.*)",
            "dest": "/static/$1"
        },
        {
            "src": "/(.*)",
            "dest": "src/web_main.py"
        }
    ],
    "github": {
        "silent": true
    }
}
